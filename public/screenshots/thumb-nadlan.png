<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 1000" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#080c18" />
      <stop offset="50%" stop-color="#0c1124" />
      <stop offset="100%" stop-color="#050711" />
    </linearGradient>
    <linearGradient id="indigoGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#4f46e5" />
      <stop offset="100%" stop-color="#7c3aed" />
    </linearGradient>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#141a33" stop-opacity="0.9" />
      <stop offset="100%" stop-color="#0e1326" stop-opacity="0.75" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="35" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#1e293b" stroke-width="0.7" stroke-opacity="0.35" />
    </pattern>
  </defs>

  <!-- Background Canvas -->
  <rect width="1600" height="1000" fill="url(#bgGrad)" />
  <rect width="1600" height="1000" fill="url(#grid)" />

  <!-- Ambient Glow -->
  <circle cx="350" cy="220" r="240" fill="#4f46e5" fill-opacity="0.12" filter="url(#glow)" />
  <circle cx="1250" cy="350" r="280" fill="#7c3aed" fill-opacity="0.1" filter="url(#glow)" />

  <!-- Main System UI Window Frame -->
  <g transform="translate(100, 70)">
    <!-- Header Window Chrome -->
    <rect x="0" y="0" width="1400" height="64" rx="14" fill="#0f172a" fill-opacity="0.95" stroke="#1e293b" stroke-width="1.5" />
    <circle cx="32" cy="32" r="6" fill="#ef4444" fill-opacity="0.8" />
    <circle cx="52" cy="32" r="6" fill="#f59e0b" fill-opacity="0.8" />
    <circle cx="72" cy="32" r="6" fill="#10b981" fill-opacity="0.8" />

    <!-- URL Bar -->
    <rect x="420" y="16" width="560" height="32" rx="8" fill="#1e293b" fill-opacity="0.7" stroke="#334155" stroke-width="1" />
    <text x="700" y="37" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" fill="#94a3b8" text-anchor="middle">
      https://nadlan.baileytv.tech
    </text>

    <!-- Top KPI Cards -->
    <g transform="translate(0, 90)">
      <!-- Card 1: Total Deals -->
      <rect x="0" y="0" width="325" height="120" rx="14" fill="url(#cardGrad)" stroke="#1e293b" stroke-width="1.5" />
      <text x="30" y="42" font-family="sans-serif" font-size="14" fill="#94a3b8">סה״כ עסקאות מדווחות</text>
      <text x="30" y="85" font-family="sans-serif" font-size="32" font-weight="bold" fill="#ffffff">3,844,200</text>
      <rect x="250" y="24" width="45" height="24" rx="6" fill="#4f46e5" fill-opacity="0.2" />
      <text x="272" y="40" font-family="sans-serif" font-size="11" font-weight="bold" fill="#818cf8" text-anchor="middle">100%</text>

      <!-- Card 2: Date Coverage -->
      <rect x="355" y="0" width="325" height="120" rx="14" fill="url(#cardGrad)" stroke="#1e293b" stroke-width="1.5" />
      <text x="385" y="42" font-family="sans-serif" font-size="14" fill="#94a3b8">טווח תאריכים</text>
      <text x="385" y="85" font-family="sans-serif" font-size="24" font-weight="bold" fill="#ffffff">1998 — 2026</text>
      <text x="385" y="105" font-family="sans-serif" font-size="12" fill="#64748b">28 שנות היסטוריה</text>

      <!-- Card 3: Settlements -->
      <rect x="710" y="0" width="325" height="120" rx="14" fill="url(#cardGrad)" stroke="#1e293b" stroke-width="1.5" />
      <text x="740" y="42" font-family="sans-serif" font-size="14" fill="#94a3b8">יישובים בפריסה ארצית</text>
      <text x="740" y="85" font-family="sans-serif" font-size="32" font-weight="bold" fill="#ffffff">1,335</text>
      <text x="740" y="105" font-family="sans-serif" font-size="12" fill="#10b981">1,020+ במפה אינטראקטיבית</text>

      <!-- Card 4: Cadastral Parcels -->
      <rect x="1065" y="0" width="335" height="120" rx="14" fill="url(#cardGrad)" stroke="#1e293b" stroke-width="1.5" />
      <text x="1095" y="42" font-family="sans-serif" font-size="14" fill="#94a3b8">חלקות קדסטרליות (גוש/חלקה)</text>
      <text x="1095" y="85" font-family="sans-serif" font-size="32" font-weight="bold" fill="#6366f1">381,177</text>
      <text x="1095" y="105" font-family="sans-serif" font-size="12" fill="#64748b">מיפוי רדיוס ועסקאות בסביבה</text>
    </g>

    <!-- Main Workspace (Split Map + Analytics) -->
    <g transform="translate(0, 235)">
      <!-- Left side: National Map Heatmap Canvas -->
      <rect x="0" y="0" width="870" height="570" rx="16" fill="#0b1120" stroke="#1e293b" stroke-width="1.5" />
      
      <!-- Mini Map Toolbar -->
      <rect x="20" y="20" width="830" height="46" rx="10" fill="#141e33" stroke="#334155" stroke-width="1" />
      <text x="40" y="48" font-family="sans-serif" font-size="14" font-weight="bold" fill="#e2e8f0">🗺️ מפה ארצית — פיזור מחירי נדל״ן</text>
      <rect x="680" y="28" width="150" height="30" rx="6" fill="#4f46e5" />
      <text x="755" y="48" font-family="sans-serif" font-size="12" font-weight="bold" fill="#ffffff" text-anchor="middle">מדד: מחיר חציוני</text>

      <!-- Map Graphics & Heat Bubbles Representation -->
      <g transform="translate(200, 90)">
        <!-- Coastline Silhouette -->
        <path d="M 120 40 Q 140 120 160 200 T 180 340 T 220 420" fill="none" stroke="#334155" stroke-dasharray="4 4" stroke-width="2" />
        
        <!-- Heatmap Circles representing major clusters -->
        <!-- Tel Aviv cluster -->
        <circle cx="160" cy="180" r="38" fill="#9333ea" fill-opacity="0.75" stroke="#ffffff" stroke-width="2" />
        <circle cx="160" cy="180" r="16" fill="#f43f5e" fill-opacity="0.9" />
        <text x="160" y="185" font-family="sans-serif" font-size="10" font-weight="bold" fill="#ffffff" text-anchor="middle">תל אביב</text>

        <!-- Jerusalem cluster -->
        <circle cx="270" cy="240" r="34" fill="#ea580c" fill-opacity="0.75" stroke="#ffffff" stroke-width="2" />
        <text x="270" y="245" font-family="sans-serif" font-size="10" font-weight="bold" fill="#ffffff" text-anchor="middle">ירושלים</text>

        <!-- Haifa cluster -->
        <circle cx="150" cy="70" r="28" fill="#eab308" fill-opacity="0.75" stroke="#ffffff" stroke-width="2" />
        <text x="150" y="75" font-family="sans-serif" font-size="10" font-weight="bold" fill="#ffffff" text-anchor="middle">חיפה</text>

        <!-- Beer Sheva cluster -->
        <circle cx="190" cy="350" r="26" fill="#10b981" fill-opacity="0.75" stroke="#ffffff" stroke-width="2" />
        <text x="190" y="355" font-family="sans-serif" font-size="10" font-weight="bold" fill="#ffffff" text-anchor="middle">באר שבע</text>

        <!-- Netanya cluster -->
        <circle cx="155" cy="125" r="22" fill="#f97316" fill-opacity="0.75" stroke="#ffffff" stroke-width="1.5" />

        <!-- Ashdod cluster -->
        <circle cx="145" cy="245" r="22" fill="#eab308" fill-opacity="0.75" stroke="#ffffff" stroke-width="1.5" />

        <!-- Rishon cluster -->
        <circle cx="160" cy="210" r="24" fill="#ea580c" fill-opacity="0.75" stroke="#ffffff" stroke-width="1.5" />
      </g>

      <!-- Right side: Sidebar Settlement Inspector -->
      <g transform="translate(895, 0)">
        <rect x="0" y="0" width="505" height="570" rx="16" fill="url(#cardGrad)" stroke="#1e293b" stroke-width="1.5" />
        
        <text x="30" y="45" font-family="sans-serif" font-size="18" font-weight="bold" fill="#ffffff">📊 כרטיסיית יישוב מהירה</text>
        <text x="30" y="70" font-family="sans-serif" font-size="13" fill="#818cf8">תל אביב -יפו · 250,853 עסקאות מדווחות</text>

        <!-- Mini Stats in Inspector -->
        <rect x="30" y="95" width="215" height="70" rx="10" fill="#1e293b" fill-opacity="0.6" />
        <text x="45" y="122" font-family="sans-serif" font-size="12" fill="#94a3b8">מחיר חציוני</text>
        <text x="45" y="148" font-family="sans-serif" font-size="18" font-weight="bold" fill="#a855f7">₪2,450,000</text>

        <rect x="260" y="95" width="215" height="70" rx="10" fill="#1e293b" fill-opacity="0.6" />
        <text x="275" y="122" font-family="sans-serif" font-size="12" fill="#94a3b8">מחיר חציוני למ״ר</text>
        <text x="275" y="148" font-family="sans-serif" font-size="18" font-weight="bold" fill="#60a5fa">₪34,200</text>

        <!-- Simulated Trend Chart -->
        <text x="30" y="200" font-family="sans-serif" font-size="13" font-weight="bold" fill="#cbd5e1">מגמת מחירים לאורך שנים (חציון)</text>
        <rect x="30" y="215" width="445" height="160" rx="10" fill="#0f172a" stroke="#1e293b" stroke-width="1" />
        <!-- Trend line -->
        <polyline points="50,340 110,330 170,300 230,285 290,260 350,235 410,245 450,230" fill="none" stroke="#6366f1" stroke-width="3" />
        <circle cx="450" cy="230" r="4" fill="#a855f7" />

        <!-- Recent Deals Table snippet -->
        <text x="30" y="410" font-family="sans-serif" font-size="13" font-weight="bold" fill="#cbd5e1">עסקאות אחרונות שדווחו</text>
        
        <rect x="30" y="425" width="445" height="42" rx="8" fill="#1e293b" fill-opacity="0.4" />
        <text x="45" y="450" font-family="sans-serif" font-size="12" font-weight="bold" fill="#ffffff">דירה בבית קומות · 3 חד׳ · 78 מ״ר</text>
        <text x="410" y="450" font-family="sans-serif" font-size="12" font-weight="bold" fill="#10b981">₪2,890,000</text>

        <rect x="30" y="475" width="445" height="42" rx="8" fill="#1e293b" fill-opacity="0.4" />
        <text x="45" y="500" font-family="sans-serif" font-size="12" font-weight="bold" fill="#ffffff">דירה בבית קומות · 4 חד׳ · 104 מ״ר</text>
        <text x="410" y="500" font-family="sans-serif" font-size="12" font-weight="bold" fill="#10b981">₪3,750,000</text>
      </g>
    </g>
  </g>
</svg>
